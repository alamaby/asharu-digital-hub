{
  "name": "asharu-digital-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Asharu digital hub — toko online, media sosial, produk afiliasi, dan properti dalam satu tempat (asharu.id)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run src/lib --coverage",
    "validate:messages": "node scripts/validate-messages.mjs",
    "check:scraper": "node scripts/check-scraper.mjs",
    "threads:auth": "node scripts/threads-poster/auth.mjs",
    "threads:probe": "node scripts/threads-poster/probe.mjs",
    "threads:post": "node scripts/threads-poster/thread.mjs",
    "test:scrape": "vitest run --config vitest.scrape.config.ts",
    "scrape:affiliate": "node scripts/scrape-affiliate.mjs",
    "scrape:affiliate:dry-run": "node scripts/scrape-affiliate.mjs --dry-run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@swc/helpers": "^0.5.23",
    "apexcharts": "^7.8.0",
    "embla-carousel-react": "^8.6.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^26.0.0",
    "jsonc-parser": "^3.3.1",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "browserslist": [
    "chrome >= 105",
    "edge >= 105",
    "firefox >= 104",
    "opera >= 91",
    "safari >= 15.4"
  ]
}
