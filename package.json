{
  "name": "asharu-digital-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Asharu digital hub — toko online, media sosial, produk afiliasi, dan properti dalam satu tempat (asharu.id)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run src/lib --coverage",
    "validate:messages": "node scripts/validate-messages.mjs",
    "check:scraper": "node scripts/check-scraper.mjs",
    "threads:auth": "node scripts/threads-poster/auth.mjs",
    "threads:probe": "node scripts/threads-poster/probe.mjs",
    "threads:post": "node scripts/threads-poster/thread.mjs",
    "test:scrape": "vitest run --config vitest.scrape.config.ts",
    "scrape:affiliate": "node scripts/scrape-affiliate.mjs",
    "scrape:affiliate:dry-run": "node scripts/scrape-affiliate.mjs --dry-run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@swc/helpers": "^0.5.23",
    "apexcharts": "^4.7.0",
    "embla-carousel-react": "^8.6.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "next-intl": "^4.0.0",
    "react": "^19.0.0",
    "react-apexcharts": "^1.9.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^31.0.0",
    "jsonc-parser": "^3.3.1",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "browserslist": [
    "chrome >= 105",
    "edge >= 105",
    "firefox >= 104",
    "opera >= 91",
    "safari >= 15.4"
  ]
}
