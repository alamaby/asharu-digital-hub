# Asharu Digital Hub — environment variables
# Copy to .env.local for local development:  cp .env.example .env.local
# Never put secrets or real personal data in this file (it is committed).
#
# ⚠️  Values below are FORMAT-VALID PLACEHOLDERS so you can see the exact
#     expected shape. Replace EVERY value with real data in your own
#     .env / .env.local (and in Vercel Environment Variables) before launch.
#     A build-time Zod check (src/lib/env.ts) fails fast on invalid formats;
#     src/lib/env.example.test.ts keeps this file format-valid automatically.

# Canonical production URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://asharu.id

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Leave empty to disable analytics entirely (no scripts, no consent banner).
# PLACEHOLDER — get yours at analytics.google.com (Admin → Data streams).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Public WhatsApp click-to-chat URL (format: https://wa.me/<international number>).
# Leave empty until a verified number exists (WhatsApp CTAs stay hidden).
# PLACEHOLDER — 628000000000 is a dummy number, NOT a reachable contact.
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/628000000000

# Public contact email. Leave empty if not yet available.
# PLACEHOLDER — replace with your monitored inbox.
NEXT_PUBLIC_CONTACT_EMAIL=hello@asharu.id

# --- Supabase (content-factory workflow) ---
# Create the project in the Supabase Dashboard, then copy the URL + anon key
# here. Both must be set for the workflow to function; leave empty until then
# (the build stays green, content pages fall back to static data).
# Uncomment and replace with real values before enabling the workflow.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix NEXT_PUBLIC_, never commit. Used by the content
# processor (Route Handler) to bypass RLS for upserts and to read Vault keys.
# Leave empty until Supabase is provisioned.
SUPABASE_SERVICE_ROLE_KEY=
