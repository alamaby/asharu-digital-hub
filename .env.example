# Asharu Digital Hub — environment variables
# Copy to .env.local for local development.
# Never put secrets or real personal data in this file.

# Canonical production URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://asharu.id

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Leave empty to disable analytics (no scripts will be loaded).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public WhatsApp contact URL (format: https://wa.me/<number>).
# Leave empty until a verified number is available.
NEXT_PUBLIC_WHATSAPP_URL=

# Public contact email. Leave empty if not yet available.
NEXT_PUBLIC_CONTACT_EMAIL=
