# Asharu Digital Hub — environment variables
# Copy to .env.local for local development:  cp .env.example .env.local
# Never put secrets or real personal data in this file (it is committed).
#
# ⚠️  Values below are FORMAT-VALID PLACEHOLDERS so you can see the exact
#     expected shape. Replace EVERY value with real data in your own
#     .env / .env.local (and in Vercel Environment Variables) before launch.
#     A build-time Zod check (src/lib/env.ts) fails fast on invalid formats;
#     src/lib/env.example.test.ts keeps this file format-valid automatically.

# Canonical production URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://asharu.id

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Leave empty to disable analytics entirely (no scripts, no consent banner).
# PLACEHOLDER — get yours at analytics.google.com (Admin → Data streams).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Public WhatsApp click-to-chat URL (format: https://wa.me/<international number>).
# Leave empty until a verified number exists (WhatsApp CTAs stay hidden).
# PLACEHOLDER — 628000000000 is a dummy number, NOT a reachable contact.
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/628000000000

# Public contact email. Leave empty if not yet available.
# PLACEHOLDER — replace with your monitored inbox.
NEXT_PUBLIC_CONTACT_EMAIL=hello@asharu.id

# --- Supabase (content-factory workflow) ---
# Create the project in the Supabase Dashboard, then copy the URL + publishable key
# here. Both must be set for the workflow to function; leave empty until then
# (the build stays green, content pages fall back to static data).
# Supabase anon key (JWT eyJ...) is deprecated — use sb_publishable_...
# Get it from Dashboard → Project Settings → API Keys → Publishable keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Deprecated alias — still accepted, prefer PUBLISHABLE above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix NEXT_PUBLIC_, never commit. Used by the content
# processor (Route Handler) to bypass RLS for upserts and to read Vault keys.
# Supabase service_role (JWT eyJ...) is deprecated end 2025 — use sb_secret_...
# Get it from Dashboard → Project Settings → API Keys → Secret keys → Create secret key.
# Leave empty until Supabase is provisioned.
SUPABASE_SECRET_KEY=
# Deprecated alias — still accepted until 2025-12, prefer SUPABASE_SECRET_KEY above.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM Provider Keys (Vault, BUKAN .env) ---
# JANGAN taruh key LLM (Naraya/OpenRouter/Gemini/Cloudflare) di .env.
# Key LLM disimpan terenkripsi di Supabase Vault (tabel llm_provider_keys),
# diisi via script: node --env-file=.env.local scripts/seed-llm-keys.mjs
# (interactive, tidak log secret) atau Dashboard → Vault → Secrets.
# .env hanya untuk Supabase URL + publishable/secret + CRON_SECRET.

# Cron secret — the ONLY authorized way to call /api/content/process:
# `Authorization: Bearer <secret>`. The spoofable `x-vercel-cron` header is
# rejected since the cron moved to Supabase pg_cron.
# The same value must live in Supabase Vault (name: asharu_cron_secret) so the
# pg_cron job can read it — seed with:
#   node --env-file=.env.local scripts/seed-cron-secret.mjs
# Leave empty in dev (anyone can POST locally); REQUIRED in Vercel Production
# (missing secret = endpoint denies every call, fail-closed).
CRON_SECRET=

# Tavily search key fallback (preferred: Supabase Vault `tavily_api_key`).
# Format: tvly-... Leave empty until provisioned.
TAVILY_API_KEY=

# --- Threads auto-post (Fase 0, Meta App statis) ---
# Threads App ID + Secret dari App Dashboard (Threads use case, BUKAN Meta App ID).
# Long-lived user token TIDAK di sini — simpan di Supabase Vault via:
#   node --env-file=.env.local scripts/seed-threads-token.mjs
# Leave empty until Fase 0 done (worker stays disabled via social_post_configs).
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=
